# Kunci API dari Cohere (https://dashboard.cohere.com)
CO_API_KEY="YOUR_COHERE_API_KEY"

# Token akun pengguna Discord
DISCORD_TOKEN="YOUR_DISCORD_TOKEN"

# --- KONFIGURASI BOT ---
# ID channel tempat bot akan aktif membalas
ALLOWED_CHANNEL_ID="YOUR_ALLOWED_CHANNEL_ID"

# (Opsional) ID voice channel agar bot tetap online 24/7 di Railway
VOICE_CHANNEL_ID="YOUR_VOICE_CHANNEL_ID"

# (Opsional) Batasi balasan hanya untuk user tertentu (pisahkan dengan koma jika lebih dari satu). Kosongkan jika ingin membalas semua user.
SPECIFIC_USER_IDS="YOUR_SPECIFIC_USER_IDS"

# (Opsional) Konfigurasi untuk pesan terjadwal (cron job pukul 07:00 WIB)
CRON_CHANNEL_ID="YOUR_CRON_CHANNEL_ID"
CRON_MESSAGE="YOUR_CRON_MESSAGE"